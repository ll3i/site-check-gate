        }
      ]
    },
    {
      "id": 4,
      "page": 1,
      "category": "paragraph",
      "content": {
        "html": "",
        "markdown": "",
        "text": "2. 법령 준수 현황"
      },
      "coordinates": [
        {
          "x": 0.4213,
          "y": 0.228
        },
        {
          "x": 0.5765,
          "y": 0.228
        },
        {
